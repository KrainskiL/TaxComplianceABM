    <monitor x="930" precision="2" y="225" height="60" fontSize="11" width="100" display="Q2-Q3 Comp %"><![CDATA[mean [ifelse-value compliant [1] [0]] of citizens with [disposable > q2 and disposable < q3]]]></monitor>
    <monitor x="930" precision="2" y="290" height="60" fontSize="11" width="100" display="Q3-Max Comp %"><![CDATA[mean [ifelse-value compliant [1] [0]] of citizens with [disposable > q3 and disposable < q4]]]></monitor>
    <monitor x="825" precision="0" y="70" height="60" fontSize="11" width="100" display="Min">q0</monitor>
    <monitor x="930" precision="2" y="95" height="60" fontSize="11" width="100" display="Min-Q1 Comp %"><![CDATA[mean [ifelse-value compliant [1] [0]] of citizens with [disposable < q1]]]></monitor>
    <monitor x="1055" precision="3" y="160" height="60" fontSize="11" width="100" display="Mean Gini">w-mean-gini</monitor>
    <monitor x="1055" precision="3" y="225" height="60" fontSize="11" width="100" display="CV Gini">sqrt get-sample-variance-gini / w-mean-gini</monitor>
    <monitor x="1160" precision="3" y="160" height="60" fontSize="11" width="100" display="Mean compliance">w-mean-comp</monitor>
    <monitor x="1160" precision="3" y="225" height="60" fontSize="11" width="100" display="CV compliance">get-sample-variance-comp / w-mean-comp</monitor>
    <monitor x="1265" precision="0" y="160" height="60" fontSize="11" width="100" display="Mean Tax">w-mean-tax</monitor>
    <monitor x="1265" precision="3" y="225" height="60" fontSize="11" width="100" display="CV Tax">sqrt get-sample-variance-tax / w-mean-tax</monitor>
    <note x="360" y="70" backgroundDark="0" fontSize="11" width="195" markdown="false" height="28" textColorDark="-1" textColorLight="-16777216" backgroundLight="0">ON: Utilitarian | OFF: Capability</note>
    <slider x="350" step="1" y="230" max="100" width="215" display="num-citizens" height="50" min="0" direction="Horizontal" default="100.0" variable="num-citizens"></slider>
