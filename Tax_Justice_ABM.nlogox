  <linkShapes>
    <shape name="default" curviness="0.0">
      <lines>
        <line x="-0.2" visible="false">
          <dash value="0.0"></dash>
          <dash value="1.0"></dash>
        </line>
        <line x="0.0" visible="true">
          <dash value="1.0"></dash>
          <dash value="0.0"></dash>
        </line>
        <line x="0.2" visible="false">
          <dash value="0.0"></dash>
          <dash value="1.0"></dash>
        </line>
      </lines>
      <indicator>
        <shape name="link direction" rotatable="true" editableColorIndex="0">
          <line endX="90" startY="150" marked="true" color="-1920102913" endY="180" startX="150"></line>
          <line endX="210" startY="150" marked="true" color="-1920102913" endY="180" startX="150"></line>
        </shape>
      </indicator>
    </shape>
  </linkShapes>
  <previewCommands>setup repeat 75 [ go ]</previewCommands>
  <experiments>
    <experiment name="Experiment1" repetitions="100" sequentialRunOrder="true" runMetricsEveryStep="false">
      <setup>random-seed (behaviorspace-run-number * 100)
setup</setup>
      <go>go</go>
      <postRun>export-agent-data
export-run-data</postRun>
      <constants>
        <enumeratedValueSet variable="world-preference">
          <value value="true"></value>
          <value value="false"></value>
        </enumeratedValueSet>
        <steppedValueSet variable="utilitarian-fraction" first="0" step="20" last="100"></steppedValueSet>
        <steppedValueSet variable="peer-influence" first="0" step="20" last="100"></steppedValueSet>
        <enumeratedValueSet variable="num-citizens">
          <value value="100"></value>
        </enumeratedValueSet>
        <steppedValueSet variable="knowledge-level" first="0" step="20" last="100"></steppedValueSet>
        <enumeratedValueSet variable="num-rounds">
          <value value="150"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="perc-top-degree-knowledgeable">
          <value value="0"></value>
        </enumeratedValueSet>
      </constants>
    </experiment>
    <experiment name="Experiment2-degree" repetitions="100" sequentialRunOrder="true" runMetricsEveryStep="false">
      <setup>random-seed (behaviorspace-run-number * 100)
setup</setup>
      <go>go</go>
      <postRun>export-agent-data
export-run-data</postRun>
      <constants>
        <enumeratedValueSet variable="world-preference">
          <value value="true"></value>
          <value value="false"></value>
        </enumeratedValueSet>
        <steppedValueSet variable="utilitarian-fraction" first="0" step="20" last="100"></steppedValueSet>
        <steppedValueSet variable="peer-influence" first="0" step="20" last="100"></steppedValueSet>
        <enumeratedValueSet variable="num-citizens">
          <value value="100"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="knowledge-level">
          <value value="0"></value>
          <value value="10"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="num-rounds">
          <value value="150"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="perc-top-degree-knowledgeable">
          <value value="0"></value>
          <value value="10"></value>
        </enumeratedValueSet>
      </constants>
    </experiment>
  </experiments>
</model>
