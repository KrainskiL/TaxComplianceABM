    <monitor x="1160" precision="2" y="95" height="60" fontSize="11" width="100" display="Compliance %">compliance-rate</monitor>
    <slider x="580" step="1" y="228" max="100" width="231" display="peer-influence" height="50" min="0" direction="Horizontal" default="50.0" variable="peer-influence"></slider>
