    <view x="30" wrappingAllowedX="false" y="10" frameRate="30.0" minPycor="-25" height="304" showTickCounter="true" patchSize="5.9" fontSize="10" wrappingAllowedY="false" width="304" tickCounterLabel="ticks" maxPycor="25" updateMode="0" maxPxcor="25" minPxcor="-25"></view>
    <slider x="580" step="10" y="100" max="100" width="231" display="utilitarian-fraction" height="50" min="0" direction="Horizontal" default="50.0" variable="utilitarian-fraction"></slider>
    <slider x="580" step="10" y="164" max="100" width="231" display="knowledge-level" height="50" min="0" direction="Horizontal" default="50.0" variable="knowledge-level"></slider>
