    <plot x="30" autoPlotX="true" yMax="100.0" autoPlotY="true" yAxis="Citizens" y="395" xMin="0.0" height="202" legend="false" xMax="100.0" yMin="0.0" width="345" xAxis="Ticks" display="Compliant Taxpayers">
