<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.3" snapToGrid="true">
  <code><![CDATA[globals [
  avg-degree ;; average node degree
  homophily-strength ;; strength of homophily mechanism
  q0 q1 q2 q3 q4 ;; min + quartiles of disposable income + max
  step-tax-collected ;; amount of taxes collected in one tick (from income + redistribution) - for reporting
  redistributable-tax ;; tax that can be redistributed in a tick - for redistribution mechanism
  cumulative-tax-collected  ; Running total of tax collected over all rounds - sum of step-tax-collected
  gini ;; Gini coefficient - measure of inequality
  log-mean  ; Mean of the logarithm of income
  log-sd    ; Standard deviation of the logarithm of income
  tax-rate  ; Average tax rate
  fraction-disadvantaged ;; Fraction of disadvantaged population to receive extra tax in capability world
  disadvantaged-tax-share-rate ; Share of taxes to be redistributed within disadvantaged - only in capability world-preference
  match-compliance-probability ;; Base compliance for citizens with preferences matching the world
  mismatch-compliance-probability ;; Base compliance for citizens with preferences not matching the world
  random-compliance-probability ;; Base compliance for citizens without knowledge
  ;; Running means and variances
  w-count  ; n: the number of observations seen so far
  w-mean-comp   ; the running average (compliance)
  w-M2-comp ; the running sum of squares of differences from the current mean (compliance)
  w-mean-gini   ; the running average (gini)
  w-M2-gini ; the running sum of squares of differences from the current mean (gini)
  w-mean-tax   ; the running average (tax)
  w-M2-tax ; the running sum of squares of differences from the current mean (tax)
]

breed [citizens citizen]

citizens-own [
  ;; Fixed attributes
  income ;; Float - Income sampled at the start of simulation
  preferences ;; String - Utilitarian, capability
  knowledge   ;; Boolean - true if citizen has knowledge about tax system
  base-compliance-probability  ;; Float - inherent compliance based on knowledge and preferences
  final-compliance-probability
  disadvantaged  ;; Boolean - true if citizens is disadvantaged, relevant for capability world
  disadvantage-severity  ;; Hard, middle, soft

  ;; Variable attributes
  disposable ;; Float - post-tax disposable amount - subject to gini and quartile calculation
  tax ;; Float - tax payed
  compliant   ;; Boolean - true if citizens is compliant in current step
  peer-influence-modifier ;; Float - Share of compliant or non-compliant neighbours affecting peer-influence
]
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;Setup and Initialization Procedures;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
to setup-welford
  set w-count 0
  set w-mean-comp 0
  set w-M2-comp 0
  set w-mean-gini 0
  set w-M2-gini 0
  set w-mean-tax 0
  set w-M2-tax 0
end

to setup
  clear-all
  setup-welford
  set step-tax-collected 0
  set redistributable-tax 0
  set cumulative-tax-collected 0

  ; Fixed parameters based on calibration and expert knowledge
  set avg-degree 5 ;; 5 based on Dunbar et al.
  set homophily-strength 2 ;; Medium strength of homophily
  set log-mean ln 58500  ; Adjusted based on empirical data
  set log-sd 0.7     ; Adjusted based on empirical data
  set tax-rate 0.37 ; Based on OECD and Polish source data
  set fraction-disadvantaged 31 ; Set based on empirical data - estimated fraction of retired and other disadvantaged population in Poland
  set disadvantaged-tax-share-rate 46 ; Set based on empirical data - estimated redistribution based on ZUS data
  set match-compliance-probability 80 ;; Increased compliance with matching preferences of citizen and world
  set mismatch-compliance-probability 20 ;; Decreased compliance with not matching preferences of citizen and world
  set random-compliance-probability 50 ;; Random compliance with no knowledge

  ask patches [ set pcolor white ] ;; White background
  set-default-shape citizens "circle" ;; Nodes as circles
  create-citizens num-citizens [
    setup-attributes
  ]

  setup-network ;; Network structure - homophily based on income
  influence-high-degrees perc-top-degree-knowledgeable

  ; Statistics and reporting
  earn-income
  calculate-gini
  calculate-quartiles
  add-running-variance
  reset-ticks
end


to setup-attributes
  setxy (random-xcor) (random-ycor)
  ;; Set income using a log-normal distribution
  set income exp random-normal log-mean log-sd
  set size sqrt income / 130 ;; Should looks nice in picked world size
  ;; Randomly assign knowledge
  set knowledge random-float 1.0 < (knowledge-level / 100)

  ;; Assign preferences based on the utilitarian-fraction slider
  ifelse random 100 < utilitarian-fraction [
    set preferences "utilitarian"
  ] [
    set preferences "capability"
  ]
  let world-preference-str ifelse-value world-preference ["utilitarian"] ["capability"]
  ;; Initialize base compliance probability
  ifelse knowledge [
    ifelse preferences = world-preference-str [
      set base-compliance-probability match-compliance-probability / 100
    ][
      set base-compliance-probability mismatch-compliance-probability / 100
    ]
  ][
    set base-compliance-probability random-compliance-probability / 100
  ]
  ;; Assign disadvantaged status
  set disadvantaged random-float 1.0 < (fraction-disadvantaged / 100)
  if disadvantaged [
    set disadvantage-severity one-of ["hard" "middle" "soft"]
  ]

  ;; Initialize compliant status randomly
  set compliant random-float 1.0 < 0.5  ;; 50% chance to start as compliant
  ifelse compliant [set color green] [set color red]
  set tax 0
  set disposable 0
end

to layout-horizontal-income
  ; Find the lowest and highest incomes in the population
  let min-inc ln min [income] of citizens
  let max-inc ln max [income] of citizens
  let inc-range (max-inc - min-inc)

  ask citizens [
    let new-x min-pxcor + (((ln income - min-inc) / inc-range) * world-width * 0.9)
    setxy new-x ycor
  ]
end

to-report relative-income-similarity [ income-a income-b ]
  ; Calculate and report the similarity score (from 0 to 1)
  let difference abs (income-a - income-b)
  let total (income-a + income-b)
  let base-similarity (1 - (difference / total))
  report base-similarity ^ homophily-strength
end

to setup-network
  layout-horizontal-income
  let n-edges avg-degree * num-citizens / 2
  let created 0
  while [created < n-edges] [
    ask one-of citizens [
      let other-citizen-without-link one-of other citizens with [not link-neighbor? myself]
      let other-income [income] of other-citizen-without-link
      let score relative-income-similarity income other-income
      if random-float 1.0 < score
      [
        create-link-with other-citizen-without-link
        set created created + 1
      ]
    ]

  ]
  repeat 10
  [
    layout-spring citizens links 0.2 (world-width / (sqrt num-citizens)) (world-width / num-citizens) * 4
  ]
  ask citizens [
    if abs xcor > max-pxcor [ set xcor max-pxcor * 0.95]
    if abs ycor > max-pycor [ set ycor max-pycor * 0.95]
  ]
end

to influence-high-degrees [top-perc-influenced]
  if top-perc-influenced > 0 [
    let sorted-degree sort [count link-neighbors] of citizens
    let index round (100 - top-perc-influenced) * num-citizens / 100
    let degree-threshold item index sorted-degree
    ask citizens with [count link-neighbors >= degree-threshold] [
      set knowledge true
    ]
  ]
end
;;;;;;;;;;;;;;;;;;;;;;;;;;
;;Statistics calculation;;
;;;;;;;;;;;;;;;;;;;;;;;;;;

to-report quartiles [ xs ]
  let med median xs
  let upper filter [ x -> x > med ] xs
  let lower filter [ x -> x < med ] xs
  set upper ifelse-value empty? upper [ med ] [ median upper ]
  set lower ifelse-value empty? lower [ med ] [ median lower ]
  report (list min xs lower med upper max xs)
end


;Quartiles calculation
to calculate-quartiles
  let list-disposable [disposable] of citizens
  let qs quartiles list-disposable
  set q0 item 0 qs
  set q1 item 1 qs
  set q2 item 2 qs
  set q3 item 3 qs
  set q4 item 4 qs
end

to calculate-gini
  let sorted-disposable sort [disposable] of citizens
  let n length sorted-disposable
  if n <= 1 [ set gini 0 ]

  let total sum sorted-disposable
  if total = 0 [ set gini 0 ]

  let indexes (range 1 (n + 1))
  let sum-index-disposable sum (map [ [i y] -> i * y ] indexes sorted-disposable)
  let s1 (2 * sum-index-disposable)
  let s2 (n * total)

  set gini (s1 / s2) - ((n + 1) / n)
end

to add-running-variance
  set w-count w-count + 1
  let delta 0
  let delta2 0
  ;; Compliance
  set delta (compliance-rate - w-mean-comp)
  set w-mean-comp w-mean-comp + (delta / w-count)
  set delta2 (compliance-rate - w-mean-comp)
  set w-M2-comp w-M2-comp + (delta * delta2)
  ;; Gini
  set delta (gini - w-mean-gini)
  set w-mean-gini w-mean-gini + (delta / w-count)
  set delta2 (gini - w-mean-gini)
  set w-M2-gini w-M2-gini + (delta * delta2)
  ;; Tax
  set delta (step-tax-collected - w-mean-tax)
  set w-mean-tax w-mean-tax + (delta / w-count)
  set delta2 (step-tax-collected - w-mean-tax)
  set w-M2-tax w-M2-tax + (delta * delta2)
end

to-report get-sample-variance-comp
  if w-count < 2 [ report 0 ]
  report w-M2-comp / (w-count - 1)
end

to-report get-sample-variance-gini
  if w-count < 2 [ report 0 ]
  report w-M2-gini / (w-count - 1)
end

to-report get-sample-variance-tax
  if w-count < 2 [ report 0 ]
  report w-M2-tax / (w-count - 1)
end

;;;;;;;;;;;;;;;;;;;;;;
;;Simulation's logic;;
;;;;;;;;;;;;;;;;;;;;;;

to go
  if ticks >= num-rounds [
    stop
  ]
  ; Main logic
  earn-income
  calculate-compliance
  collect-taxes
  redistribute-tax
  calculate-gini
  calculate-quartiles
  add-running-variance
  tick
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;Tax Calculation and Compliance;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to calculate-compliance
  ask citizens [
    let compliant-neighbors count link-neighbors with [compliant]
    let noncompliant-neighbors count link-neighbors with [not compliant]
    let total-neighbors count link-neighbors

    ;; Calculate the fraction of compliant and noncompliant neighbors
    let compliant-fraction ifelse-value (total-neighbors > 0) [compliant-neighbors / total-neighbors] [0]
    let noncompliant-fraction ifelse-value (total-neighbors > 0) [noncompliant-neighbors / total-neighbors] [0]

    ;; Apply peer influence
    let peer-influence-compliance 0
    let peer-influence-noncompliance 0
    set peer-influence-modifier 0
    if compliant-neighbors > noncompliant-neighbors [
      set peer-influence-modifier compliant-fraction
      set peer-influence-compliance peer-influence / 100 * peer-influence-modifier
    ]
    if noncompliant-neighbors > compliant-neighbors [
      set peer-influence-modifier noncompliant-fraction
      set peer-influence-noncompliance peer-influence / 100 * peer-influence-modifier
    ]

    set final-compliance-probability base-compliance-probability + peer-influence-compliance - peer-influence-noncompliance
    set final-compliance-probability max list 0 (min list 1 final-compliance-probability)

    set compliant random-float 1.0 < final-compliance-probability
    ifelse compliant [set color green] [set color red]
  ]
end


to-report compliance-rate
  if num-citizens = 0 [report 0]
  report count citizens with [compliant] / num-citizens
end

to earn-income
  ask citizens [
   set disposable income
  ]
end

to collect-taxes
  set step-tax-collected 0
  ask citizens [
    ifelse compliant [
      set tax disposable * tax-rate
      set disposable disposable - tax
      set redistributable-tax redistributable-tax + tax
      set step-tax-collected step-tax-collected + tax
    ]
    [
      set tax 0
    ]
  ]
end

;Income Redistribution
to redistribute-tax
  ;; Redistribute the collected taxes based on world preference
  ifelse world-preference [
    redistribute-utilitarian
  ] [
    redistribute-capability
  ]
  set cumulative-tax-collected cumulative-tax-collected + (step-tax-collected / 1000000)
end


to redistribute-capability
  let total-weights sum (map [severity ->
    ifelse-value (severity = "hard") [3]
    [ifelse-value (severity = "middle") [2]
    [ifelse-value (severity = "soft") [1]
        [0]]]] [disadvantage-severity] of citizens)

  let redistribution-pool redistributable-tax
  let base-share redistribution-pool * (1 - disadvantaged-tax-share-rate / 100) / count citizens
  let additional-tax-collected redistribution-pool * disadvantaged-tax-share-rate / 100  ;; disadvantaged-tax-share-rate of the collected tax goes into weighted distribution
  set redistributable-tax 0

  ask citizens [
      let severity-weight ifelse-value (disadvantage-severity = "hard") [3]
                           [ifelse-value (disadvantage-severity = "middle") [2]
                              [ifelse-value (disadvantage-severity = "soft") [1]
                              [0]]]
      let disadvantaged-share (severity-weight / total-weights) * additional-tax-collected
      let my-subsidy-tax tax-rate * (base-share + disadvantaged-share)
      set step-tax-collected step-tax-collected + my-subsidy-tax
      set redistributable-tax redistributable-tax + my-subsidy-tax
      set disposable disposable + (1 - tax-rate) * (base-share + disadvantaged-share)
  ]
end

to redistribute-utilitarian
  let total-disposable sum [disposable] of citizens
  let average-disposable total-disposable / num-citizens
  let poorest citizens with [disposable < average-disposable]
  let total-diff sum [average-disposable - disposable] of poorest
  let redistribution-pool redistributable-tax
  set redistributable-tax 0

  ask poorest [
    let my-diff (average-disposable - disposable)
    let my-tax-share (my-diff / total-diff)

    let my-subsidy (1 - tax-rate) * (redistribution-pool * my-tax-share)
    set disposable disposable + my-subsidy
    let my-subsidy-tax tax-rate * redistribution-pool * my-tax-share
    set step-tax-collected step-tax-collected + my-subsidy-tax
    set redistributable-tax redistributable-tax + my-subsidy-tax
  ]
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;Data Collection and Export;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
to export-agent-data
  let filename (word "/Users/lukasz/Desktop/tax_compliance_results/agent-data-run-" behaviorspace-run-number ".csv")
  file-open filename
  file-print "run,tick,who,income,disposable,compliant,knowledge,disadvantaged,base-compliance-probability,final-compliance-probability,peer-influence-modifier,degree"
  ask citizens [
    ; word combines everything into one comma-separated string
    file-print (word behaviorspace-run-number "," ticks "," who "," income "," disposable "," compliant "," knowledge "," disadvantaged "," base-compliance-probability "," final-compliance-probability "," peer-influence-modifier "," count link-neighbors)
  ]
  file-close
end

to export-run-data
  let filename (word "/Users/lukasz/Desktop/tax_compliance_results/data-run-" behaviorspace-run-number ".csv")
  file-open filename
  file-print "run-number,tick,world-preference,utilitarian-fraction,peer-influence,num-citizens,knowledge-level,perc-top-degree,gini,gini-mean,gini-var,total-tax,step-tax,step-tax-mean,step-tax-var,compliance-rate,compliance-rate-mean,compliance-rate-var"
  file-print (word behaviorspace-run-number "," ticks "," world-preference "," utilitarian-fraction "," peer-influence "," num-citizens "," knowledge-level "," perc-top-degree-knowledgeable "," gini "," w-mean-gini "," get-sample-variance-gini "," cumulative-tax-collected "," step-tax-collected "," w-mean-tax "," get-sample-variance-tax "," compliance-rate "," w-mean-comp "," get-sample-variance-comp )
  file-close
end]]></code>
