    <monitor x="825" precision="0" y="200" height="60" fontSize="11" width="100" display="Q2">q2</monitor>
    <monitor x="825" precision="0" y="265" height="60" fontSize="11" width="100" display="Q3">q3</monitor>
    <monitor x="825" precision="0" y="330" height="60" fontSize="11" width="100" display="Max">q4</monitor>
    <monitor x="1265" precision="0" y="95" height="60" fontSize="11" width="100" display="Tax">sum [tax] of citizens</monitor>
